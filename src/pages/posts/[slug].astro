---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header';
import Footer from '../../components/Footer';
import { getGuidePackageLinks } from '../../data/editorial-links';
import { loadPackageCatalog } from '../../data/package-catalog';
import { getVerifiedPackages } from '../../data/verified-package';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((entry: any) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: any;
}

const { entry } = Astro.props;
// @ts-ignore
const { Content } = await entry.render();
const relatedPackageLinks = getGuidePackageLinks(entry.slug, getVerifiedPackages(loadPackageCatalog()));

// Rút trích tiêu đề H1 từ markdown nếu có; nếu thiếu thì dùng title frontmatter trước khi fallback sang slug.
const contentStr = entry.body || '';
const titleMatch = contentStr.match(/^#\s+(.+)$/m);
const hasContentH1 = Boolean(titleMatch || /<h1(?:\s|>)/i.test(contentStr));
const displayTitle = titleMatch ? titleMatch[1] : (entry.data?.title || entry.slug.replace(/-/g, ' '));
const seoTitle = entry.data?.title || displayTitle;
const publishedTime = entry.data?.date instanceof Date ? entry.data.date.toISOString() : undefined;

// Hàm chọn ảnh minh họa cao cấp khớp chính xác với từng nội dung bài viết
function getPostImage(slug: string, title: string) {
  const s = (slug + ' ' + title).toLowerCase();
  if (s.includes('dang-ky-multisim-viettel') || s.includes('apple watch')) {
    return '/images/blogger/topic-b1-esim-5g-tuong-thich-4435b941a4f9.svg';
  }
  if (s.includes('samsung-galaxy-z-fold8-esim-viettel')) {
    return '/images/blogger/topic-b1-esim-5g-tuong-thich-4435b941a4f9.svg';
  }
  if (s.includes('oppo-find-x9-esim-viettel')) {
    return '/images/oppo-find-x9-esim-5g-viettel.svg';
  }
  if (s.includes('redmi-note-17-pro-5g-esim-viettel')) {
    return '/images/redmi-note-17-esim-5g-viettel.svg';
  }
  if (s.includes('esim') && s.includes('5g')) {
    return '/images/blogger/topic-b1-esim-5g-tuong-thich-4435b941a4f9.svg';
  }
  if (s.includes('bat-volte-viettel-android')) {
    return '/images/volte-viettel-android.svg';
  }
  if (s.includes('esim-viettel-yeu-song-khong-gui-duoc-sms')) {
    return '/images/blogger/b5-complete-16-e9ba5da114a8.svg';
  }
  if (s.includes('ussd-viettel-qua-4g-volte-ims')) {
    return '/images/blogger/topic-b1-ussd-2g-tat-can-cap-nhat-gi-0a95b8de4e45.svg';
  }
  if (s.includes('sim-4g-viettel-co-dung-duoc-5g-khong')) {
    return '/images/blogger/topic-b2-5g-doi-sim-727def8baa2d.svg';
  }
  if (s.includes('cai-dat-4g-5g-volte-iphone-viettel')) {
    return '/images/blogger/topic-b1-iphone-chon-4g-5g-volte-357f792e08cc.svg';
  }
  if (s.includes('kiem-tra-toc-do-mang-my-viettel')) {
    return '/images/viettel-4g-speed-banner.jpg';
  }
  if (s.includes('cai-apn-viettel-4g-5g-v-internet') || s.includes('apn viettel')) {
    return '/images/apn-viettel-v-internet.svg';
  }
  if (s.includes('dien-thoai-ban-phim-4g-viettel-volte-tat-2g')) {
    return '/images/tat-song-2g-volte-viettel.svg';
  }
  if (s.includes('tat-song-2g-15-9-2026-viettel-volte')) {
    return '/images/tat-song-2g-volte-viettel.svg';
  }
  if (s.includes('kiem-tra') || s.includes('kiểm tra') || s.includes('kiểm-tra') || s.includes('tai-khoan') || s.includes('tài khoản') || s.includes('so-dien-thoai') || s.includes('số điện thoại') || s.includes('dung-luong') || s.includes('dung lượng')) {
    return '/images/viettel-check-balance-banner.jpg';
  }
  if (s.includes('huy') || s.includes('hủy') || s.includes('tranh-tru-tien') || s.includes('tránh trừ tiền') || s.includes('gia-han') || s.includes('gia hạn')) {
    return '/images/viettel-cancel-package-banner.jpg';
  }
  if (s.includes('combo') || s.includes('thoai') || s.includes('thoại') || s.includes('v90b') || s.includes('v120b') || s.includes('v150b') || s.includes('v200b') || s.includes('v300b')) {
    return '/images/viettel-combo-call-data-banner.jpg';
  }
  if (s.includes('mxh') || s.includes('tiktok') || s.includes('youtube') || s.includes('social') || s.includes('facebook')) {
    return '/images/viettel-4g-social-banner.jpg';
  }
  if (s.includes('lien-quan') || s.includes('liên quân') || s.includes('game') || s.includes('gaming')) {
    return '/images/5g-gaming.jpg';
  }
  if (s.includes('loi') || s.includes('lỗi') || s.includes('khong-thanh-cong') || s.includes('không thành công') || s.includes('khac-phuc') || s.includes('khắc phục')) {
    return '/images/5g-error.jpg';
  }
  if (s.includes('so-sanh') || s.includes('so sánh') || s.includes('multisim')) {
    return '/images/5g-compare.jpg';
  }
  return '/images/viettel-4g-speed-banner.jpg';
}

const heroImage = getPostImage(entry.slug, displayTitle);
---
<BaseLayout
  title={`${seoTitle} | TraCuuGoiCuoc.com`}
  description={entry.data?.description}
  image={heroImage}
  canonical={`/posts/${entry.slug}`}
  pageType="article"
  publishedTime={publishedTime}
>
  <Header client:load />
  
  <div class="bg-[#f8fafc] min-h-screen py-8 pt-24 font-sans">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-xs font-semibold text-gray-500 uppercase tracking-wider mb-6">
        <a href="/" class="hover:text-red-600 transition-colors">Trang chủ</a>
        <span>/</span>
        <a href="/tin-tuc" class="hover:text-red-600 transition-colors">Tin tức & Hướng dẫn</a>
        <span>/</span>
        <span class="text-red-600 truncate max-w-[200px] sm:max-w-xs">{displayTitle}</span>
      </nav>
      <div class="bg-white rounded-2xl shadow-xl shadow-slate-900/5 p-6 sm:p-10 md:p-12 border border-gray-100">
        <div class="flex flex-wrap items-center justify-between gap-4 pb-6 mb-6 border-b border-gray-100">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-red-600 text-white font-black text-sm flex items-center justify-center italic shadow-sm">5G</div>
            <div>
              <p class="text-xs font-extrabold text-gray-900 uppercase">TraCuuGoiCuoc.com</p>
              <p class="text-[11px] text-gray-500">Nội dung tham khảo theo nguồn được dẫn</p>
            </div>
          </div>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-red-50 text-red-600 border border-red-100">Nội dung tham khảo</span>
        </div>
        <div class="mb-8 rounded-2xl overflow-hidden shadow-md border border-gray-200 relative group">
          <img src={heroImage} alt={displayTitle} class="w-full h-[240px] sm:h-[340px] md:h-[400px] object-cover group-hover:scale-105 transition-transform duration-700" loading="eager" />
          <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent p-4 sm:p-6 text-white">
            <span class="inline-block bg-red-600 text-white text-[10px] sm:text-xs font-extrabold px-2.5 py-0.5 rounded uppercase tracking-wider mb-1">Hướng dẫn Viettel</span>
            <p class="text-xs sm:text-sm text-gray-200 font-medium truncate">Hình minh họa: {displayTitle}</p>
          </div>
        </div>
        <article class="viettel-post-content">
          {!hasContentH1 && <h1>{displayTitle}</h1>}
          <Content />
        </article>
        {relatedPackageLinks.length > 0 && (
          <aside class="mt-10 rounded-2xl border border-red-100 bg-red-50 p-6" aria-label="Gói cước liên quan">
            <h2 class="text-lg font-extrabold text-gray-900">Gói cước liên quan</h2>
            <ul class="mt-3 flex flex-wrap gap-3">
              {relatedPackageLinks.map(({ href, label }) => (
                <li><a href={href} class="inline-flex rounded-full bg-white px-4 py-2 text-sm font-bold text-red-600 shadow-sm ring-1 ring-red-100 transition-colors hover:bg-red-100">{label}</a></li>
              ))}
            </ul>
          </aside>
        )}
        <div class="mt-14 p-6 sm:p-8 rounded-2xl bg-gradient-to-r from-red-600 to-red-700 text-white shadow-lg relative overflow-hidden">
          <div class="relative z-10 flex flex-col sm:flex-row items-center justify-between gap-6 text-center sm:text-left">
            <div>
              <span class="text-xs font-bold uppercase tracking-widest bg-white/20 px-2.5 py-1 rounded-full">Danh mục gói cước</span>
              <h3 class="text-xl sm:text-2xl font-black mt-2">Bạn cần so sánh các gói có thông tin còn hiệu lực?</h3>
              <p class="text-sm text-red-100 mt-1">Xem các gói có fact nguồn, giá trị và điều kiện được hiển thị rõ trên từng trang.</p>
            </div>
            <div class="flex flex-col sm:flex-row gap-3 shrink-0 w-full sm:w-auto">
              <a href="/goi-cuoc" class="inline-flex items-center justify-center px-6 py-3 rounded-full text-sm font-extrabold bg-white text-red-600 hover:bg-red-50 transition-colors shadow-md min-h-[48px]">Xem danh mục gói →</a>
            </div>
          </div>
        </div>
        <div class="mt-8 pt-6 border-t border-gray-100 flex flex-col sm:flex-row items-center justify-between gap-4">
          <a href="/tin-tuc" class="inline-flex items-center justify-center px-6 py-3 rounded-full text-sm font-bold bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors min-h-[44px] w-full sm:w-auto">← Xem tất cả hướng dẫn Viettel</a>
          <a href="tel:18008098" class="inline-flex items-center justify-center px-6 py-3 rounded-full text-sm font-bold bg-red-50 text-red-600 hover:bg-red-100 transition-colors min-h-[44px] w-full sm:w-auto">📞 Gọi tổng đài Viettel: 1800.8098</a>
        </div>
      </div>
    </div>
  </div>
  <Footer client:load />
</BaseLayout>
