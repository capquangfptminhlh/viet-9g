---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeApp from '../components/HomeApp';
import { loadPackageCatalog } from '../data/package-catalog';
import { getVerifiedPackages } from '../data/verified-package';

const packages = getVerifiedPackages(loadPackageCatalog());
---
<BaseLayout
  title="Gói Cước Viettel 4G/5G: Tra Cứu Data, Giá & Đăng Ký"
  description="Tra cứu gói cước Viettel 4G/5G theo giá, dung lượng và nhu cầu sử dụng. Xem điều kiện áp dụng, nguồn tham khảo và đăng ký bằng cú pháp MÃ_GÓI GB gửi 290."
  canonical="/"
>
  <h1 class="sr-only">Gói cước Viettel 4G/5G: tra cứu data, giá, ưu đãi và đăng ký</h1>
  <HomeApp packages={packages} client:load />
</BaseLayout>
