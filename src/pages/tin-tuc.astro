---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header';
import Footer from '../components/Footer';

const posts = await getCollection('posts');

// Hàm chọn ảnh minh họa theo chủ đề bài viết khớp chính xác nội dung
function getPostImage(slug: string, title: string) {
  const s = (slug + ' ' + title).toLowerCase();
  if (s.includes('esim-viettel-yeu-song-khong-gui-duoc-sms')) {
    return '/images/blogger/b5-complete-16-e9ba5da114a8.svg';
  }
  if (s.includes('ussd-viettel-qua-4g-volte-ims')) {
    return '/images/blogger/topic-b1-ussd-2g-tat-can-cap-nhat-gi-0a95b8de4e45.svg';
  }
  if (s.includes('sim-4g-viettel-co-dung-duoc-5g-khong')) {
    return '/images/blogger/topic-b2-5g-doi-sim-727def8baa2d.svg';
  }
  if (s.includes('cai-dat-4g-5g-volte-iphone-viettel')) {
    return '/images/blogger/topic-b1-iphone-chon-4g-5g-volte-357f792e08cc.svg';
  }
  if (s.includes('cai-apn-viettel-4g-5g-v-internet') || s.includes('apn viettel')) {
    return '/images/apn-viettel-v-internet.svg';
  }
  if (s.includes('kiem-tra') || s.includes('kiểm tra') || s.includes('kiểm-tra') || s.includes('tai-khoan') || s.includes('tài khoản') || s.includes('so-dien-thoai') || s.includes('số điện thoại') || s.includes('dung-luong') || s.includes('dung lượng')) {
    return '/images/viettel-check-balance-banner.jpg';
  }
  if (s.includes('huy') || s.includes('hủy') || s.includes('tranh-tru-tien') || s.includes('tránh trừ tiền') || s.includes('gia-han') || s.includes('gia hạn')) {
    return '/images/viettel-cancel-package-banner.jpg';
  }
  if (s.includes('combo') || s.includes('thoai') || s.includes('thoại') || s.includes('v90b') || s.includes('v120b') || s.includes('v150b') || s.includes('v200b') || s.includes('v300b')) {
    return '/images/viettel-combo-call-data-banner.jpg';
  }
  if (s.includes('mxh') || s.includes('tiktok') || s.includes('youtube') || s.includes('social') || s.includes('facebook')) {
    return '/images/viettel-4g-social-banner.jpg';
  }
  if (s.includes('lien-quan') || s.includes('liên quân') || s.includes('game') || s.includes('gaming')) {
    return '/images/5g-gaming.jpg';
  }
  if (s.includes('loi') || s.includes('lỗi') || s.includes('khong-thanh-cong') || s.includes('không thành công') || s.includes('khac-phuc') || s.includes('khắc phục')) {
    return '/images/5g-error.jpg';
  }
  if (s.includes('so-sanh') || s.includes('so sánh') || s.includes('multisim')) {
    return '/images/5g-compare.jpg';
  }
  return '/images/viettel-4g-speed-banner.jpg';
}

// Chuẩn bị danh sách bài viết với tiêu đề, tóm tắt và ảnh thumbnail rút trích từ nội dung markdown
type FormattedPost = { slug: string; title: string; excerpt: string; image: string };
const formattedPosts: FormattedPost[] = posts.map((post: { slug: string; body?: string }) => {
  const content = post.body || '';
  const titleMatch = content.match(/^#\s+(.+)$/m);
  const title = titleMatch ? titleMatch[1] : post.slug.replace(/-/g, ' ');
  
  // Rút trích đoạn văn đầu tiên (không phải heading hoặc quote) để làm mô tả
  const lines = content.split('\n');
  let excerpt = 'Hướng dẫn chi tiết cú pháp đăng ký, tra cứu và sử dụng ưu đãi dịch vụ di động Viettel mới nhất năm 2026.';
  for (const line of lines) {
    const trimmed = line.trim();
    if (trimmed && !trimmed.startsWith('#') && !trimmed.startsWith('---') && !trimmed.startsWith('*') && trimmed.length > 30) {
      excerpt = trimmed.replace(/\*\*/g, '').slice(0, 160) + '...';
      break;
    }
  }

  const image = getPostImage(post.slug, title);

  return {
    slug: post.slug,
    title,
    excerpt,
    image
  };
});

---
<BaseLayout title="Tin Tức & Hướng Dẫn Đăng Ký Gói Cước Viettel 2026 | tracuugoicuoc.com">
  <Header client:load />
  
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 pt-24 min-h-screen font-sans">
    {/* Header banner */}
    <div class="bg-gradient-to-r from-red-600 to-red-700 rounded-2xl shadow-xl p-6 sm:p-10 text-white mb-10">
      <div class="max-w-3xl">
        <span class="inline-block bg-white/20 text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider mb-3">
          Kênh Kiến Thức & AEO/SEO
        </span>
        <h1 class="text-3xl sm:text-4xl font-black uppercase tracking-tight leading-tight">
          Tin Tức & Hướng Dẫn Viettel
        </h1>
        <p class="text-red-100 text-sm sm:text-base mt-3 leading-relaxed">
          Cập nhật các hướng dẫn sử dụng dịch vụ, đăng ký gói cước, kiểm tra tài khoản và xử lý lỗi phổ biến dựa trên nguồn được dẫn.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">
      {formattedPosts.map((post) => (
        <article class="bg-white rounded-2xl border border-gray-100 shadow-lg shadow-slate-900/5 overflow-hidden flex flex-col hover:-translate-y-1 hover:shadow-xl transition-all duration-300">
          <a href={`/posts/${post.slug}/`} class="block overflow-hidden bg-gray-100 aspect-[16/9]">
            <img src={post.image} alt={post.title} class="w-full h-full object-cover hover:scale-105 transition-transform duration-700" loading="lazy" />
          </a>
          <div class="p-5 sm:p-6 flex flex-col flex-1">
            <div class="flex items-center gap-2 text-[11px] font-bold text-red-600 uppercase tracking-wider mb-3">
              <span>Hướng dẫn Viettel</span>
              <span class="text-gray-300">•</span>
              <span class="text-gray-500">2026</span>
            </div>
            <h2 class="text-lg sm:text-xl font-extrabold text-gray-900 leading-snug mb-3">
              <a href={`/posts/${post.slug}/`} class="hover:text-red-600 transition-colors">{post.title}</a>
            </h2>
            <p class="text-sm text-gray-600 leading-relaxed mb-5 flex-1">{post.excerpt}</p>
            <a href={`/posts/${post.slug}/`} class="inline-flex items-center text-sm font-extrabold text-red-600 hover:text-red-700 min-h-[44px]">
              Xem hướng dẫn →
            </a>
          </div>
        </article>
      ))}
    </div>
  </main>

  <Footer client:load />
</BaseLayout>