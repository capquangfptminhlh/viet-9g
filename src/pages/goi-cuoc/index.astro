---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { packageHubs } from '../../data/package-hubs';
import { getPackageRoutes } from '../../data/package-routes';

const title = 'Gói cước Viettel 4G/5G: Data, Combo, Mạng Xã Hội';
const description = 'Tra cứu gói cước Viettel theo nhóm data, 5G, combo và mạng xã hội. Mỗi trang chỉ hiển thị các dữ kiện và điều kiện đã có nguồn xác minh.';
const verifiedPackages = getPackageRoutes();
---
<BaseLayout title={title} description={description} canonical="/goi-cuoc">
  <main class="mx-auto max-w-5xl px-4 py-12">
    <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-red-600">Danh mục tra cứu</p>
    <h1 class="mt-2 text-3xl font-black text-slate-900">{title}</h1>
    <p class="mt-3 max-w-3xl leading-7 text-slate-600">{description}</p>
    <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600">
      Bắt đầu từ nhóm nhu cầu phù hợp, sau đó mở trang từng mã gói để kiểm tra giá, chu kỳ, dung lượng và điều kiện nào đang có dữ liệu được xác minh. Website không mặc định mọi gói đều áp dụng cho mọi thuê bao.
    </p>

    <section class="mt-8" aria-labelledby="package-groups">
      <h2 id="package-groups" class="text-2xl font-black text-slate-900">Chọn nhóm gói cước</h2>
      <nav class="mt-4 grid gap-4 sm:grid-cols-2" aria-label="Danh mục gói cước">
        {packageHubs.map((hub) => (
          <a href={`/goi-cuoc/${hub.slug}`} class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-red-300 hover:shadow">
            <h3 class="font-bold text-red-700">{hub.title}</h3>
            <p class="mt-2 text-sm text-slate-600">{hub.description}</p>
          </a>
        ))}
      </nav>
    </section>

    <section class="mt-12 border-t border-slate-200 pt-8" aria-labelledby="verified-package-pages">
      <h2 id="verified-package-pages" class="text-2xl font-black text-slate-900">Trang gói đã được xác minh</h2>
      <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-600">
        Các liên kết dưới đây trỏ trực tiếp đến canonical owner của từng mã gói đang có dữ liệu Viettel còn hiệu lực trong catalog của website.
      </p>
      <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {verifiedPackages.map((pkg) => (
          <a href={`/goi-cuoc/${pkg.id.toLowerCase()}`} class="rounded-xl border border-slate-200 bg-white p-4 transition hover:border-red-300 hover:shadow-sm">
            <span class="block font-black text-red-700">{pkg.code}</span>
            <span class="mt-1 block text-xs text-slate-500">{pkg.name}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-12 rounded-2xl border border-slate-200 bg-white p-6" aria-labelledby="package-support-guides">
      <h2 id="package-support-guides" class="text-xl font-black text-slate-900">Đang dùng gói và cần kiểm tra hoặc hủy?</h2>
      <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-600">
        Các nhu cầu hỗ trợ có intent khác với đăng ký gói mới. Hãy mở đúng hướng dẫn để tránh nhầm giữa số dư tài khoản, dung lượng data và trạng thái gia hạn.
      </p>
      <div class="mt-4 flex flex-wrap gap-x-5 gap-y-3">
        <a href="/posts/cach-kiem-tra-tai-khoan-chinh" class="text-sm font-bold text-red-700 underline decoration-red-200 underline-offset-4 hover:decoration-red-500">Kiểm tra tài khoản Viettel</a>
        <a href="/posts/cach-huy-goi-mxh120" class="text-sm font-bold text-red-700 underline decoration-red-200 underline-offset-4 hover:decoration-red-500">Cách hủy gói MXH120</a>
        <a href="/tin-tuc" class="text-sm font-bold text-red-700 underline decoration-red-200 underline-offset-4 hover:decoration-red-500">Tin tức & hướng dẫn Viettel</a>
      </div>
    </section>
  </main>
</BaseLayout>
