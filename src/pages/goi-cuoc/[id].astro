---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DynamicPostPage from '../../components/DynamicPostPage';
import { getPackageRoutes } from '../../data/package-routes';

export async function getStaticPaths() {
  return getPackageRoutes().map((pkg) => ({
    params: { id: pkg.id.toLowerCase() },
    props: { pkg },
  }));
}

const { pkg } = Astro.props;
---
<BaseLayout title={`Gói ${pkg.name} Viettel`} description={pkg.description}>
  <DynamicPostPage pkg={pkg} />
</BaseLayout>
