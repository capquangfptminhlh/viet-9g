---
import PackageHub from '../../components/PackageHub';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPackageHub, getPackageHubPaths, groupPackagesForHub } from '../../data/package-hubs';
import { getPackageRoutes } from '../../data/package-routes';

export function getStaticPaths() {
  return getPackageHubPaths(getPackageRoutes());
}

const hub = getPackageHub(Astro.params.category ?? '');
if (!hub) {
  return new Response(null, { status: 404 });
}

const packages = groupPackagesForHub(hub, getPackageRoutes());
const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: hub.title,
  itemListElement: packages.map((pkg, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: pkg.name,
    url: new URL(`/goi-cuoc/${pkg.id.toLowerCase()}`, Astro.site).href,
  })),
};
---
<BaseLayout
  title={hub.title}
  description={hub.description}
  canonical={`/goi-cuoc/${hub.slug}`}
  jsonLd={itemListJsonLd}
>
  <main>
    <PackageHub hub={hub} packages={packages} />
  </main>
</BaseLayout>
