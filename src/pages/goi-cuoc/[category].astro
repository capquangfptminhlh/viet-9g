---
import PackageHub from '../../components/PackageHub';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPackageHub, getPackageHubPaths, groupPackagesForHub } from '../../data/package-hubs';
import { getPackageRoutes } from '../../data/package-routes';

export function getStaticPaths() {
  return getPackageHubPaths(getPackageRoutes());
}

const hub = getPackageHub(Astro.params.category ?? '');
if (!hub) {
  return new Response(null, { status: 404 });
}

const packages = groupPackagesForHub(hub, getPackageRoutes());
const pageUrl = new URL(`/goi-cuoc/${hub.slug}`, Astro.site).href;
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Trang chủ', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Gói cước', item: new URL('/goi-cuoc', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: hub.title, item: pageUrl },
  ],
};
const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: hub.title,
  itemListElement: packages.map((pkg, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: pkg.name,
    url: new URL(`/goi-cuoc/${pkg.id.toLowerCase()}`, Astro.site).href,
  })),
};
---
<BaseLayout title={hub.title} description={hub.description}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />
  </Fragment>
  <main>
    <PackageHub hub={hub} packages={packages} />
  </main>
</BaseLayout>
