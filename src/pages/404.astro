---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 - Không Tìm Thấy Trang | Tra cứu gói cước Viettel">
  <div class="min-h-[70vh] flex flex-col items-center justify-center px-4 py-16 text-center">
    <h1 class="text-6xl sm:text-8xl font-black text-[#D71920] tracking-tighter mb-4">404</h1>
    <h2 class="text-xl sm:text-2xl font-bold text-gray-900 mb-6">Trang bạn tìm kiếm không tồn tại</h2>
    <p class="text-sm text-gray-600 max-w-md mx-auto mb-8 leading-relaxed">
      Liên kết này có thể đã bị hỏng, đổi tên hoặc đã bị xóa. Vui lòng kiểm tra lại đường dẫn hoặc quay lại trang chủ.
    </p>
    <a href="/" class="px-6 py-3.5 bg-[#D71920] text-white text-sm font-bold rounded-lg shadow hover:bg-red-700 transition-colors inline-flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
      Quay Lại Trang Chủ
    </a>
  </div>
</BaseLayout>
