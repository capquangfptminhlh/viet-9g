{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://4viettel.local/schemas/package-catalog.schema.json",
  "type": "object",
  "required": ["schemaVersion", "catalogVersion", "generatedAt", "packages"],
  "x-runtimeConstraints": {
    "authoritativeValidator": "src/data/package-catalog.ts#parsePackageCatalog",
    "rules": [
      "package IDs and codes are globally unique",
      "fact IDs are globally unique and every package factIds entry resolves only from that package's local facts or catalog-level global facts",
      "facts require HTTPS sourceUrl on the viettel.vn hostname allowlist and valid effective/expiry ordering",
      "active packages require current evidence and registration data; hold, unverified, eligibility_required, and retired packages may omit registration; renderable records require expiry strictly after now and effectiveAt at or before now"
    ]
  },
  "x-publicOfferConstraints": {
    "factKeys": ["priceVnd", "durationDays", "dataAllowance", "dataPerDay", "benefit", "eligibility", "checkingInstruction", "renewalInstruction", "cancellationInstruction", "registrationSyntax"],
    "requirements": [
      "public offers require current official positive numeric priceVnd and durationDays facts plus a current official non-empty string dataAllowance or dataPerDay fact",
      "registration CTA requires a referenced current official registrationSyntax fact whose string value exactly matches the normalized registration syntax"
    ]
  },
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "catalogVersion": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "sourceSnapshot": { "type": "object" },
    "facts": { "type": "array", "items": { "$ref": "#/$defs/fact" } },
    "packages": { "type": "array", "items": { "$ref": "#/$defs/package" } }
  },
  "$defs": {
    "fact": {
      "type": "object", "required": ["id", "key", "value", "claim", "sourceUrl", "retrievedAt", "effectiveAt", "expiresAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "key": { "type": "string", "minLength": 1 },
        "value": { "oneOf": [{ "type": "string" }, { "type": "number", "exclusiveMinimum": 0 }, { "type": "boolean" }] }, "unit": { "type": "string" }, "claim": { "type": "string", "minLength": 1 },
        "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://([^.]+\\.)*viettel\\.vn(/|$)" }, "retrievedAt": { "type": "string", "format": "date-time" },
        "effectiveAt": { "type": "string", "format": "date" }, "expiresAt": { "type": "string", "format": "date-time" }
      }, "additionalProperties": false
    },
    "package": {
      "type": "object", "required": ["id", "code", "status", "category", "factIds", "display", "facts"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "code": { "type": "string", "minLength": 1 },
        "status": { "enum": ["active", "eligibility_required", "hold", "retired", "unverified", "operator_verified"] },
        "category": { "enum": ["hot", "data", "social", "combo", "long_term"] },
        "factIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "display": { "type": "object", "required": ["name", "description"], "properties": { "name": { "type": "string" }, "description": { "type": "string" }, "benefits": { "type": "array", "items": { "type": "string" } }, "eligibility": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": true },
        "registration": { "type": "object", "required": ["syntax", "smsNumber", "channel"], "properties": { "syntax": { "type": "string", "pattern": "\\bGB\\b" }, "smsNumber": { "enum": [290, "290"] }, "channel": { "const": "sms" }, "factId": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
        "facts": { "type": "array", "items": { "$ref": "#/$defs/fact" } }
      }, "additionalProperties": true
    }
  }
}
